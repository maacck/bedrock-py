{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "bedrock-docs-web",
  // The encoded OpenNext source maps exceed Cloudflare's 60 MiB upload limit.
  "upload_source_maps": false,
  // Set this to today's date
  "compatibility_date": "2026-05-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
        {
          "name": "RATE_LIMITER",
          "class_name": "RateLimiter",
        },
        {
          "name": "THREAD_STORE",
          "class_name": "ThreadStore",
        },
      ],
    },
    "migrations": [
      {
        "tag": "v1",
        "new_sqlite_classes": ["RateLimiter"],
      },
      {
        "tag": "v2",
        "new_sqlite_classes": ["ThreadStore"],
      },
    ],
}
