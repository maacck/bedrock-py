[project]
name = "{{ project_name }}"
version = "0.1.0"
description = ""
requires-python = ">=3.12"
dependencies = [
    "bedrock>=0.1.0",
    "fastapi>=0.115.0",
    "sqlalchemy>=2.0.0",
    "uvicorn>=0.34.0",
]

[build-system]
requires = ["uv_build>=0.8,<0.9"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-root = "src"
module-name = "{{ package_base }}"